# Copie este arquivo para ".env" e preencha. O ".env" NUNCA vai para o GitHub.

# String de conexão do MongoDB Atlas (Connect > Drivers), já com a senha no lugar de <password>
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/

# Porta local (na nuvem/Docker o padrão é 3000)
PORT=3001

# Liga o CORS só para testes locais. Na nuvem o CORS fica no API Gateway.
ENABLE_CORS=true

# Opcional, só local: use se aparecer o erro "querySrv ECONNREFUSED" ao conectar no Atlas.
DNS_SERVIDORES=8.8.8.8,1.1.1.1
